# Copy this file to .env and fill in your key.
# Default provider is Groq (free tier, OpenAI-compatible API).
# Get a key at https://console.groq.com

LLM_API_KEY=your_key_here
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.3-70b-versatile
PORT=8787

# --- To use OpenAI instead ---
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini

# --- To use a local Ollama model instead ---
# LLM_API_URL=http://localhost:11434/v1/chat/completions
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama   (Ollama ignores the value but the header must be present)
